# Staging. Copy to .env in the deployment's directory and replace every
# CHANGE_ME. The .env holds the credentials, so keep it mode 600 and nowhere
# else.

HUMANDBS_TZ=Asia/Tokyo

HUMANDBS_POSTGRES_USER=humandbs
HUMANDBS_POSTGRES_PASSWORD=CHANGE_ME
HUMANDBS_POSTGRES_DB=humandbs

# What the served application connects as. The migrate job creates this role
# from this URL and grants it read and write on every table, but only SELECT
# and INSERT on `event`. Its password is its own, not the owner's.
HUMANDBS_DATABASE_URL=postgres://humandbs_app:CHANGE_ME@db:5432/humandbs

# What owns the schema: the user and password above. Given only to the migrate
# and tools services, never to the served application.
HUMANDBS_OWNER_DATABASE_URL=postgres://humandbs:CHANGE_ME@db:5432/humandbs

# The DDBJ Keycloak. The client is public and uses PKCE, so there is no secret.
# **The site's origin is derived from the redirect URI**: write the address the
# site is reached at from outside, and have it registered on the client first.
HUMANDBS_AUTH_ISSUER_URL=https://idp-staging.ddbj.nig.ac.jp/realms/master
HUMANDBS_AUTH_CLIENT_ID=CHANGE_ME
HUMANDBS_AUTH_REDIRECT_URI=https://CHANGE_ME/auth/callback

# Where the proxy listens. Reached from the TLS terminator on another host, so
# bound to every address; the port is the one the terminator forwards to.
HUMANDBS_PUBLIC_PORT=CHANGE_ME
HUMANDBS_PUBLIC_BIND_HOST=0.0.0.0

# The file store's key pair. **Generate a pair for this deployment** — they are
# what `/private/` is protected by. Neither may contain `|`, `&`, `\` or `"`.
HUMANDBS_S3_ENDPOINT=http://s3:8333
HUMANDBS_S3_ACCESS_KEY=CHANGE_ME
HUMANDBS_S3_SECRET_KEY=CHANGE_ME

# Where the database and the file store live: `pgdata/` and `s3data/` under it,
# both made beforehand and owned by the deploying user.
HUMANDBS_DATA_DIR=CHANGE_ME

# The JGA application system, reachable from inside the bastion. Forced
# read-only by the application.
HUMANDBS_JGA_DATABASE_URL=CHANGE_ME
HUMANDBS_JGA_DB_SCHEMA=

# The application assistant. Empty unless `assistant-api` is started, in which
# case it is http://assistant-api:8000.
HUMANDBS_ASSISTANT_ORIGIN=
HUMANDBS_WEB_ORIGIN=https://CHANGE_ME/
HUMANDBS_ASSISTANT_LLM_TEMPERATURE=0.2
HUMANDBS_ASSISTANT_GOOGLE_CLOUD_PROJECT_ID=
HUMANDBS_ASSISTANT_GOOGLE_GENAI_MODEL=
HUMANDBS_ASSISTANT_GOOGLE_GENAI_LOCATION=
HUMANDBS_ASSISTANT_GOOGLE_CLOUD_API_KEY=
HUMANDBS_ASSISTANT_GOOGLE_CSE_ID=
HUMANDBS_ASSISTANT_DOCUMENT_AI_LOCATION=us
HUMANDBS_ASSISTANT_DOCUMENT_AI_PROCESSOR_ID=
HUMANDBS_ASSISTANT_DDBJ_SEARCH_API_BASE_URL=https://ddbj.nig.ac.jp/search/api/entries/jga-dataset/
HUMANDBS_ASSISTANT_GENAI_CACHE_ENABLED=false
HUMANDBS_ASSISTANT_PLAYWRIGHT_CACHE_TTL_SECONDS=3600
HUMANDBS_ASSISTANT_INVESTIGATE_RESEARCHER_HISTORY=false
