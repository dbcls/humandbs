# Copy to .env before the first `docker compose up`. These values are for local
# development only; the S3 credentials live in docker/s3/s3.json.
HUMANDBS_TZ=Asia/Tokyo

HUMANDBS_POSTGRES_USER=humandbs
HUMANDBS_POSTGRES_PASSWORD=humandbs
HUMANDBS_POSTGRES_DB=humandbs
HUMANDBS_POSTGRES_BIND_PORT=5432

# What the application connects as. `npm run db:grants` creates this role from
# this URL and gives it read and write on every table, but only SELECT and
# INSERT on `event` — that is what makes the log append-only.
HUMANDBS_DATABASE_URL=postgres://humandbs_app:humandbs_app@db:5432/humandbs

# What owns the schema, as created by the db service above. Used by
# `drizzle-kit push`, the grant script and the reset in the database tests.
HUMANDBS_OWNER_DATABASE_URL=postgres://humandbs:humandbs@db:5432/humandbs

# The staging DDBJ Keycloak. The client is public and uses PKCE, so there is no
# secret; `humandbs-dev` has the redirect URI below already registered.
HUMANDBS_AUTH_ISSUER_URL=https://idp-staging.ddbj.nig.ac.jp/realms/master
HUMANDBS_AUTH_CLIENT_ID=humandbs-dev
HUMANDBS_AUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# The port the proxy listens on. It has to match the redirect URI above, which
# is registered with Keycloak and cannot be changed from here.
HUMANDBS_PUBLIC_PORT=8080

# The file store, inside the compose network. The credentials are the `app`
# identity in docker/s3/s3.json; every presigned URL a browser gets is signed
# with them, because the store cannot tell who is asking.
HUMANDBS_S3_ENDPOINT=http://s3:8333
HUMANDBS_S3_ACCESS_KEY=humandbs-dev
HUMANDBS_S3_SECRET_KEY=humandbs-dev-secret

# The JGA application system, which is the master of the controlled-access user
# list, of the hum-to-accession correspondence and of the JGA dates. **Leave it
# empty here.** The database is not reachable from a development machine and
# those three sources are skipped without it; to try them, open a tunnel through
# the bastion and point this at it (docs/development.md の
# 「上流のキャッシュを更新する」). The connection is forced read-only.
HUMANDBS_JGA_DATABASE_URL=
HUMANDBS_JGA_DB_SCHEMA=

# The application assistant, which runs beside the portal and is reached only
# through it (docs/assistant.md). **Leave it empty unless the service is up.**
# The screen says the assistant is not running rather than failing, and nothing
# else reads this. With the profile started
# (`docker compose --profile assistant up -d`) it is http://assistant-api:8000.
HUMANDBS_ASSISTANT_ORIGIN=

# Azure OpenAI deployment name used by assistant-api.
HUMANDBS_ASSISTANT_AZURE_OPENAI_MODEL=
# Azure OpenAI API key used by assistant-api.
HUMANDBS_ASSISTANT_AZURE_OPENAI_API_KEY=
# Azure OpenAI endpoint URL used by assistant-api.
HUMANDBS_ASSISTANT_AZURE_OPENAI_ENDPOINT=
# Azure OpenAI API version used by assistant-api.
HUMANDBS_ASSISTANT_AZURE_OPENAI_API_VERSION=
# Sampling temperature used by assistant-api LLM requests.
HUMANDBS_ASSISTANT_LLM_TEMPERATURE=0.2
# Google Cloud project used by assistant-api.
HUMANDBS_ASSISTANT_GOOGLE_CLOUD_PROJECT_ID=
# Google GenAI location used by assistant-api.
HUMANDBS_ASSISTANT_GOOGLE_GENAI_LOCATION=
# Google Cloud API key used by assistant-api custom search.
HUMANDBS_ASSISTANT_GOOGLE_CLOUD_API_KEY=
# Google Custom Search Engine ID used by assistant-api.
HUMANDBS_ASSISTANT_GOOGLE_CSE_ID=
# Document AI processor location used by assistant-api OCR.
HUMANDBS_ASSISTANT_DOCUMENT_AI_LOCATION=us
# Document AI processor ID used by assistant-api OCR.
HUMANDBS_ASSISTANT_DOCUMENT_AI_PROCESSOR_ID=
# DDBJ dataset-search API base URL used by assistant-api.
HUMANDBS_ASSISTANT_DDBJ_SEARCH_API_BASE_URL=https://ddbj.nig.ac.jp/search/api/entries/jga-dataset/
# Whether assistant-api caches Google GenAI responses.
HUMANDBS_ASSISTANT_GENAI_CACHE_ENABLED=false
# How long assistant-api retains Playwright page cache entries, in seconds.
HUMANDBS_ASSISTANT_PLAYWRIGHT_CACHE_TTL_SECONDS=3600
# Whether assistant-api investigates researchers during processing.
HUMANDBS_ASSISTANT_INVESTIGATE_RESEARCHER_HISTORY=false
