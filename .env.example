# Copy to .env before the first `docker compose up`. These values are for local
# development only; the S3 credentials live in docker/s3/s3.json.
HUMANDBS_TZ=Asia/Tokyo

HUMANDBS_POSTGRES_USER=humandbs
HUMANDBS_POSTGRES_PASSWORD=humandbs
HUMANDBS_POSTGRES_DB=humandbs
HUMANDBS_POSTGRES_BIND_PORT=5432

# Must address the db service with the credentials above.
HUMANDBS_DATABASE_URL=postgres://humandbs:humandbs@db:5432/humandbs

# The port the proxy listens on. The Keycloak client registers
# http://localhost:8080/auth/callback as its redirect URI, so this stays 8080.
HUMANDBS_PUBLIC_PORT=8080
