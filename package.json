    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.1",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "rehype-raw": "^7.0.0",
