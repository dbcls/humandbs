upstream frontend {
  server frontend:3000;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;
  client_max_body_size 500m;

  proxy_connect_timeout 60s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location ^~ /api/ {
    proxy_pass ${HUMANDBS_BACKEND_ORIGIN};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
  }

  location ~ "^/files/hum[0-9]{4,6}(/|$)" {
    root /var/www;
    try_files $uri =404;
    add_header Cache-Control "public, max-age=3600";
    sendfile on;
    tcp_nopush on;
  }

  location / {
    proxy_pass http://frontend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # The session cookie carries the whole token response (access + refresh + id
    # token), so the headers of the /auth/callback redirect exceed the default
    # one-page (4k) buffer and nginx answers 502 "upstream sent too big header".
    proxy_buffers 8 32k;
    proxy_buffer_size 32k;
    proxy_busy_buffers_size 64k;
  }
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  "" "";
}
